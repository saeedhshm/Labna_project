{
  "name": "@labna/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @labna/contracts && tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "seed": "npm run build -w @labna/contracts && tsx --env-file=.env src/seed.ts",
    "openapi": "tsx src/export-openapi.ts"
  },
  "dependencies": {
    "@labna/contracts": "*",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
