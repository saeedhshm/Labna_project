    "about.bilingual.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تبديل واجهة التطبيق كاملة بين العربية والإنجليزية مع دعم اتجاه القراءة المناسب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The complete interface switches between Arabic and English with the appropriate reading direction."
          }
        }
      }
    },
    "about.bilingual.title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجربة ثنائية اللغة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bilingual experience"
          }
        }
      }
    },
    "about.body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صُممت لبنة لتقديم كتالوج ألبان واضح وهادئ، مع معلومات العبوات والأسعار والتوفر في مكان واحد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Labna is designed as a clear, calm dairy catalog with pack, price and availability information in one place."
          }
        }
      }
    },
    "about.catalog.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفح الأقسام والمنتجات والعبوات، ثم جرّب إضافة اختياراتك إلى السلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse categories, products and pack sizes, then try adding selections to your cart."
          }
        }
      }
    },
    "about.catalog.title" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كتالوج ألبان بسيط"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A simple dairy catalog"
          }
        }
      }
    },
    "about.demo.message" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المنتجات والفروع والطلبات الحالية بيانات توضيحية. لا ينفذ التطبيق شراءً أو تواصلًا حقيقيًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current products, branches and orders are illustrative. The app performs no real purchase or contact."
          }
        }
      }
    },
    "about.demo.title" : {
      "localizations" : {
