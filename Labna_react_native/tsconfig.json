{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny":true,
    "strictNullChecks": true,
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution":"bundler",
    "target": "esnext",
    "lib": ["ES2020"],
    "paths":{
      "@src/*":["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
